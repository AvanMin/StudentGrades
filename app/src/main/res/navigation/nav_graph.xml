<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.studentgrades.ui.home.HomeFragment"
        android:label="Оценки">
        <action
            android:id="@+id/action_homeFragment_to_disciplineGradesFragment"
            app:destination="@id/disciplineGradesFragment" />
        <action
            android:id="@+id/action_homeFragment_to_addEditGradeFragment"
            app:destination="@id/addEditGradeFragment" />
    </fragment>

    <fragment
        android:id="@+id/disciplineGradesFragment"
        android:name="com.example.studentgrades.ui.grades.DisciplineGradesFragment"
        android:label="Дисциплина">
        <argument
            android:name="disciplineId"
            app:argType="long" />
        <action
            android:id="@+id/action_disciplineGradesFragment_to_addEditGradeFragment"
            app:destination="@id/addEditGradeFragment" />
    </fragment>

    <fragment
        android:id="@+id/addEditGradeFragment"
        android:name="com.example.studentgrades.ui.addedit.AddEditGradeFragment"
        android:label="Добавить оценку">
        <argument
            android:name="disciplineId"
            app:argType="long"
            android:defaultValue="-1L" />
        <argument
            android:name="gradeId"
            app:argType="long"
            android:defaultValue="-1L" />
    </fragment>

    <fragment
        android:id="@+id/dynamicsFragment"
        android:name="com.example.studentgrades.ui.dynamics.DynamicsFragment"
        android:label="Динамика" />

    <fragment
        android:id="@+id/goalFragment"
        android:name="com.example.studentgrades.ui.dynamics.DynamicsFragment"
        android:label="Цель" />
</navigation>